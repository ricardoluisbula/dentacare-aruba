# Copy this file to .env.local for local development, and configure the same
# values in Vercel under Project Settings -> Environment Variables.
#
# ARUBA DRAFT: nothing here is required to run or preview the draft. The site
# is noindex everywhere while SITE_IS_DRAFT is true (src/lib/site.ts).

# --- Site URL --------------------------------------------------------------
# Usually leave empty. Preview deployments use their own Vercel URL, local
# development uses http://localhost:3000, and a Vercel production deployment
# uses the project's own production URL. Set this only once the Aruba
# production domain has been chosen (and update PRODUCTION_URL in
# src/lib/site.ts at the same time).
NEXT_PUBLIC_SITE_URL=

# --- Analytics (optional, disabled until set) -------------------------------
# Google Analytics 4 measurement ID (starts with "G-"). Analytics only loads
# when this is set -- leave empty to keep the site tracking-free.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console (optional, after launch only) --------------------
# The content value of the HTML verification meta tag Search Console gives
# you when verifying via the "HTML tag" method. Just the token value.
GOOGLE_SITE_VERIFICATION=

# The reference site's contact-form settings (RESEND_API_KEY,
# CONTACT_FROM_EMAIL, CONTACT_TO_EMAIL) are intentionally absent: the Aruba
# draft has no contact form or /api/contact route. They return together with
# the form once the practice confirms which inbox should receive messages.
